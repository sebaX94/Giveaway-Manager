[Unit]
Description=Twitch Giveaway Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/giveaway-service
EnvironmentFile=/home/pi/giveaway-service/.env
ExecStart=/home/pi/giveaway-service/.venv/bin/python -m uvicorn main:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=5
StandardOutput=append:/home/pi/giveaway-service/logs/systemd.out.log
StandardError=append:/home/pi/giveaway-service/logs/systemd.err.log

[Install]
WantedBy=multi-user.target